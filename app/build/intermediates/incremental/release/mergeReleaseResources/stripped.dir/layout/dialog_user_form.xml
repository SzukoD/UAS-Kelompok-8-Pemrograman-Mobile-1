<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/TextAppearance.InventoryApp.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        tools:text="Tambah Pengguna" />

    <EditText android:id="@+id/etNamaLengkap" style="@style/InputField" android:hint="Nama Lengkap" />
    <EditText android:id="@+id/etUsername" style="@style/InputField" android:hint="Username" />
    <EditText android:id="@+id/etPassword" style="@style/InputField" android:hint="Password" android:inputType="textPassword" />

    <TextView style="@style/InputLabel" android:text="Role" />
    <Spinner android:id="@+id/spRole" style="@style/InputField" />

</LinearLayout>
