<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/TextAppearance.InventoryApp.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        tools:text="Tambah Supplier" />

    <EditText android:id="@+id/etNama" style="@style/InputField" android:hint="Nama Supplier" />
    <EditText android:id="@+id/etKontak" style="@style/InputField" android:hint="Kontak (telepon/email)" />
    <EditText android:id="@+id/etAlamat" style="@style/InputField" android:hint="Alamat" />

</LinearLayout>
